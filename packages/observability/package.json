{
  "name": "@paas/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Powertools for AWS Lambda presets: structured logs with PII redaction, tracing, metrics, bound to ExecutionContext",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@paas/runtime-context": "workspace:*"
  },
  "devDependencies": {
    "@paas/eslint-config": "workspace:*",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
