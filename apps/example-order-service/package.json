{
  "name": "@paas/example-order-service",
  "version": "0.1.0",
  "private": true,
  "description": "Example bounded context: Order API (HTTP API + Lambda + DynamoDB + outbox → EventBridge)",
  "type": "module",
  "exports": {
    "./infra": {
      "types": "./infra/order-service-stack.ts",
      "default": "./infra/order-service-stack.ts"
    },
    "./infra/web": {
      "types": "./infra/order-web-experimental-stack.ts",
      "default": "./infra/order-web-experimental-stack.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src infra test",
    "test": "vitest run",
    "build:web": "esbuild src/entrypoints/web/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/web/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev:web": "AWS_LAMBDA_HTTP_ENDPOINT=127.0.0.1:3000 PAAS_ENVIRONMENT=sandbox tsx src/entrypoints/web/server.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/idempotency": "^2.36.0",
    "@aws-lambda-powertools/batch": "^2.36.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-eventbridge": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@middy/core": "^7.9.2",
    "@paas/api-contracts": "workspace:*",
    "@paas/constructs": "workspace:*",
    "@paas/event-contracts": "workspace:*",
    "@paas/observability": "workspace:*",
    "@paas/runtime-context": "workspace:*",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "zod": "^4.6.7",
    "hono": "^4.13.13",
    "@hono/node-server": "^2.1.5"
  },
  "devDependencies": {
    "@paas/eslint-config": "workspace:*",
    "@paas/testing": "workspace:*",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "esbuild": "^0.28.2"
  }
}
